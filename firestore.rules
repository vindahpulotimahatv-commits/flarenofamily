rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: ambil data role user yang sedang login
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return request.auth != null && getUserData().role == "admin";
    }

    function isOwnerChild(childId) {
      return request.auth != null && getUserData().childId == childId;
    }

    // ---------- users ----------
    // Setiap user hanya boleh membaca dokumennya sendiri (untuk cek role).
    // Hanya admin yang boleh menulis/mengubah data users.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // ---------- children ----------
    // Admin: baca & tulis semua data anak.
    // Anak: hanya boleh membaca datanya sendiri, tidak boleh mengubah apa pun
    // (XP, saldo, status HP hanya diubah oleh admin / Phase 2 nanti oleh Cloud Function).
    match /children/{childId} {
      allow read: if isAdmin() || isOwnerChild(childId);
      allow write: if isAdmin();
    }

    // Semua collection lain (tasks, points, rewards, dst) akan
    // ditambahkan aturannya di Phase 2-4 saat fiturnya dibuat.
    // Default: tolak semua akses yang belum diatur di atas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
